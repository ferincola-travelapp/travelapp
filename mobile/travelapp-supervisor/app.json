{
  "expo": {
    "name": "TravelApp Supervisor",
    "owner": "fer-travelapp",
    "slug": "travelapp-supervisor",
    "scheme": "travelapp-supervisor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ar.travelapp.supervisor",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TravelApp Supervisor utiliza tu ubicación para centrar el mapa de monitoreo satelital de tu flota."
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "ar.travelapp.supervisor",
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/6b13d12b-552d-4098-84ac-4bd3c44f92cc",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "6b13d12b-552d-4098-84ac-4bd3c44f92cc"
      }
    }
  }
}
