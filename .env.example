# =============================================================================
# TRAVELAPP ECOSYSTEM — Plantilla de Variables de Entorno
# Copiá este archivo como .env.local y completá los valores reales
# ⚠️ Este archivo SÍ se versiona en Git (no contiene secretos reales)
# =============================================================================

# -----------------------------------------------------------------------------
# FIREBASE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# GOOGLE MAPS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# GOOGLE GEMINI AI (Motor Cognitivo de Travis)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# META WHATSAPP CLOUD API (Canal Oficial WhatsApp de Travis)
# Obtener en https://developers.facebook.com > Tu App > WhatsApp > API Setup
# -----------------------------------------------------------------------------
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=travelapp_meta_verify_2026
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_GRAPH_API_VERSION=v19.0

# -----------------------------------------------------------------------------
# ZAPIER — Webhooks
# -----------------------------------------------------------------------------
ZAPIER_WEBHOOK_NEW_LEAD=
ZAPIER_WEBHOOK_NEW_BOOKING=
ZAPIER_WEBHOOK_REWARDS=
ZAPIER_WEBHOOK_PARTNER_ONBOARDING=

# -----------------------------------------------------------------------------
# MANYCHAT
# -----------------------------------------------------------------------------
MANYCHAT_API_TOKEN=
MANYCHAT_TRAVIS_RESPONSE_FIELD_ID=
MANYCHAT_INCOMING_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# MERCADO PAGO — Checkout Pro + Split de Pagos (Marketplace Producción)
# Obtener en: https://www.mercadopago.com.ar/developers/panel
# -----------------------------------------------------------------------------
# Clave pública (frontend)
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Access Token privado (backend)
MP_ACCESS_TOKEN=

# Para el flujo OAuth 2.0 de choferes y pasajeros (MP Connect / Marketplace)
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# URL de retorno OAuth (debe coincidir con la configurada en MP Dashboard)
MP_OAUTH_REDIRECT_URI=http://localhost:3000/api/mp/oauth/callback

# Clave de firma criptográfica para seguridad de Webhooks
MP_WEBHOOK_SECRET=

# Porcentaje por defecto de comisión que retiene TravelCab (ej: 10 = 10%)
MP_MARKETPLACE_FEE_PERCENTAGE=10

# -----------------------------------------------------------------------------
# NAVE (BANCO GALICIA) — Pagos de Excursiones y Paquetes de Viajes
# Obtener en https://navenegocios.ar > Developers
# -----------------------------------------------------------------------------
NAVE_ENVIRONMENT=sandbox
NAVE_CLIENT_ID=
NAVE_CLIENT_SECRET=
NAVE_POS_ID=
NAVE_STORE_CODE=

# -----------------------------------------------------------------------------
# APLICACIÓN
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
