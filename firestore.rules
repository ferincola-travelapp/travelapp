rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES HELPER DE SEGURIDAD ---

    // 1. Verifica si la solicitud viene de un usuario autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. Verifica si el ID del usuario coincide con la solicitud
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 3. Verifica si el usuario posee rol de Administrador Global u Operador
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin_global' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_owner == true);
    }

    // 4. Verifica si el usuario posee rol de Supervisor de Flota activo
    function isSupervisor() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/supervisors/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/supervisors/$(request.auth.uid)).data.status != 'Suspendido') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSupervisor == true)) ||
        isAdmin()
      );
    }

    // 5. Previene la modificación de campos sensibles de administración (ej. roles, saldos, comisiones)
    function notModifyingSensitiveFields(sensitiveFields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(sensitiveFields);
    }

    // --- REGLAS PÚBLICAS Y CONTENIDO (Landing Page, CMS, Excursiones) ---

    match /cms/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cms_blocks/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /experiences/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ota_packages/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /pickup_hotels/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /discount_codes/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /experience_reservations/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    match /tariffs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /branches/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /rewards_catalog/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /rewards_config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /home_native_cards/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- USUARIOS Y PERFILES DE PASAJEROS ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Evita auto-asignación de roles administrativos al crear cuenta
      allow create: if (isOwner(userId) &&
        !request.resource.data.keys().hasAny(['isAdmin', 'is_owner', 'isSupervisor']) &&
        (!('role' in request.resource.data) || request.resource.data.role in ['user', 'passenger', 'client', 'driver']) &&
        (!('rol' in request.resource.data) || request.resource.data.rol in ['user', 'passenger', 'client', 'driver']))
        || isAdmin();
      // El usuario no puede auto-otorgarse rol de administrador ni alterar saldo de billetera
      allow update: if (isOwner(userId) &&
        notModifyingSensitiveFields(['isAdmin', 'role', 'rol', 'is_owner', 'isSupervisor', 'walletBalance']) &&
        (!('rewardsPoints' in request.resource.data) || request.resource.data.rewardsPoints >= 0))
        || isSupervisor()
        || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      // Subcolecciones privadas del usuario (favoritos, billetera, historial)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- CONDUCTORES Y FLOTA (DRIVERS) ---
    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      allow create: if (isAuthenticated() && request.auth.uid == driverId) || isSupervisor() || isAdmin();
      // Chofer puede actualizar ubicación GPS, estado online y balance operativo de viajes,
      // Supervisores pueden aprobar/suspender y gestionar documentos,
      // Pasajeros autenticados solo pueden actualizar calificación o puntos pendientes del viaje.
      allow update: if (isAuthenticated() && request.auth.uid == driverId &&
                       notModifyingSensitiveFields(['maxNegativeBalance', 'allowedServiceModes']))
                    || isSupervisor()
                    || isAdmin()
                    || (isAuthenticated() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['pendingRewardsPoints', 'pendingRewardsArs', 'rating', 'totalRatings', 'reviewsCount', 'updatedAt']));
      allow delete: if isAdmin();

      // Subcolecciones del conductor (transacciones, gastos, vehículos, notificaciones)
      match /transactions/{txId} {
        allow read: if (isAuthenticated() && request.auth.uid == driverId) || isSupervisor() || isAdmin();
        allow create: if (isAuthenticated() && request.auth.uid == driverId) || isSupervisor() || isAdmin();
        allow update, delete: if isAdmin();
      }
      match /expenses/{expId} {
        allow read, write: if (isAuthenticated() && request.auth.uid == driverId) || isAdmin();
      }
      match /vehicles/{vehicleId} {
        allow read, write: if (isAuthenticated() && request.auth.uid == driverId) || isSupervisor() || isAdmin();
      }
      match /notifications/{notifId} {
        allow read, update: if (isAuthenticated() && request.auth.uid == driverId) || isSupervisor() || isAdmin();
        allow create, delete: if isSupervisor() || isAdmin();
      }
    }

    // --- GESTIÓN DE VIAJES Y LOGÍSTICA (TRIPS) ---
    match /trips/{tripId} {
      // Lectura: Pasajero del viaje, Chofer asignado, Supervisor, Administrador o viajes buscando chofer
      allow read: if isAuthenticated() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.status == 'searching' ||
        resource.data.status == 'requested' ||
        resource.data.status == 'scheduled' ||
        isSupervisor() ||
        isAdmin()
      );

      // Creación: Pasajero creando su viaje o Chofer iniciando viaje de Taxímetro Digital
      allow create: if isAuthenticated() && (
        request.resource.data.passengerId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.driverId == request.auth.uid ||
        isAdmin()
      );

      // Actualización: Pasajero, Conductor asignado, Supervisor o Admin
      allow update: if isAuthenticated() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        request.resource.data.driverId == request.auth.uid ||
        isSupervisor() ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // Subcolección de Chat en vivo del viaje (Pasajero <-> Conductor)
      match /messages/{messageId} {
        allow read, create, update, delete: if isAuthenticated();
      }
    }

    // --- CONFIGURACIÓN DEL SISTEMA ---
    match /system_config/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- EXPERIENCIAS Y SALIDAS PROPIAS / MI VIAJE (CONTRACTED TRIPS) ---
    match /contracted_trips/{tripId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin();

      // Subcolecciones de fotos en vivo, chat grupal, comunicados y vouchers
      match /{subcollection=**} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // --- SUPERVISORES DE FLOTA ---
    match /supervisors/{supervisorId} {
      allow read: if isOwner(supervisorId) || isSupervisor() || isAdmin();
      allow create: if isAdmin();
      allow update: if (isOwner(supervisorId) && notModifyingSensitiveFields(['role', 'status', 'commissionRate'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- SOLICITUDES DE RETIRO (CONDUCTORES Y SUPERVISORES) ---
    match /payout_requests/{reqId} {
      allow read: if isAuthenticated() && (resource.data.supervisorId == request.auth.uid || isSupervisor() || isAdmin());
      allow create: if isSupervisor() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /withdrawal_requests/{reqId} {
      allow read: if isAuthenticated() && (resource.data.driverId == request.auth.uid || isSupervisor() || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.driverId == request.auth.uid;
      allow update, delete: if isSupervisor() || isAdmin();
    }

    // --- COMUNICADOS DE FLOTA (SUPERVISORES -> CONDUCTORES) ---
    match /fleet_announcements/{annId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSupervisor() || isAdmin();
    }

    // --- CANJES DE BENEFICIOS REWARDS ---
    match /reward_redemptions/{redemptionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- REGISTROS DE AUDITORÍA INMUTABLES (AUDIT LOGS) ---
    match /audit_logs/{logId} {
      allow read: if isSupervisor() || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // --- SOLICITUDES DE PARTNERS Y CONDUCTORES (PARTNER APPLICATIONS) ---
    match /partner_applications/{appId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // --- CRM CLIENTES & EXPEDIENTES ---
    match /crm_customers/{customerId} {
      allow read: if isAuthenticated() && (request.auth.uid == customerId || isAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == customerId || isAdmin());
      allow delete: if isAdmin();
    }

    // --- AFILIADOS (AFFILIATES) ---
    match /affiliates/{affiliateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == affiliateId;
      allow update: if isAuthenticated() && (request.auth.uid == affiliateId || isAdmin());
      allow delete: if isAdmin();
    }

    // --- COORDINADORES DE EXPERIENCIAS ---
    match /coordinators/{coordId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- NOTIFICACIONES PUSH & IN-APP ---
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.target in ['all', 'drivers', 'passengers'] ||
        !('userId' in resource.data) ||
        isSupervisor() ||
        isAdmin()
      );
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if isAdmin() || isSupervisor() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
  }
}
