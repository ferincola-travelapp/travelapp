rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES HELPER DE SEGURIDAD ---

    // 1. Verifica si la solicitud viene de un usuario autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. Verifica si el ID del usuario coincide con la solicitud
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 3. Verifica si el usuario posee rol de Administrador Global u Operador
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin_global' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_owner == true);
    }

    // 4. Previene la modificación de campos sensibles de administración (ej. roles, saldos, comisiones)
    function notModifyingSensitiveFields(sensitiveFields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(sensitiveFields);
    }

    // --- REGLAS PÚBLICAS Y CONTENIDO (Landing Page, CMS, Excursiones) ---

    match /cms/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cms_blocks/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /experiences/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ota_packages/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /pickup_hotels/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /discount_codes/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /experience_reservations/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    match /tariffs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /branches/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /rewards_catalog/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- USUARIOS Y PERFILES DE PASAJEROS ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      // El usuario no puede auto-otorgarse el rol de administrador ni alterar sus puntos directamente
      allow update: if isOwner(userId) && notModifyingSensitiveFields(['isAdmin', 'role', 'rol', 'is_owner', 'rewardsPoints']);
      allow write: if isAdmin();

      // Subcolecciones privadas del usuario (favoritos, billetera, historial)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- CONDUCTORES Y FLOTA (DRIVERS) ---
    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == driverId;
      // Chofer puede actualizar ubicación GPS y estado online, pero NO sus balances de comisión ni modos autorizados
      allow update: if (isAuthenticated() && request.auth.uid == driverId && 
                       notModifyingSensitiveFields(['maxNegativeBalance', 'currentCommissionBalance', 'allowedServiceModes', 'rating'])) 
                    || isAdmin();
      allow delete: if isAdmin();

      // Subcolecciones del conductor (transacciones, gastos)
      match /transactions/{txId} {
        allow read: if isAuthenticated() && request.auth.uid == driverId;
        allow write: if isAdmin();
      }
      match /expenses/{expId} {
        allow read, write: if isAuthenticated() && request.auth.uid == driverId;
      }
    }

    // --- GESTIÓN DE VIAJES Y LOGÍSTICA (TRIPS) ---
    match /trips/{tripId} {
      // Lectura: Pasajero del viaje, Chofer asignado o Administrador
      allow read: if isAuthenticated() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin() ||
        resource.data.status == 'searching' ||
        resource.data.status == 'requested'
      );
      
      // Creación: Usuario autenticado creando un viaje donde él es el pasajero
      allow create: if isAuthenticated() && request.resource.data.passengerId == request.auth.uid;
      
      // Actualización:
      // - Pasajero puede cancelar o añadir incentivo
      // - Conductor asignado puede cambiar el estado del viaje (accepted, arrived, in_progress, completed)
      // - Administrador puede gestionar cualquier viaje
      allow update: if isAuthenticated() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        request.resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // --- CONFIGURACIÓN DEL SISTEMA ---
    match /system_config/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- EXPERIENCIAS Y SALIDAS PROPIAS / MI VIAJE (CONTRACTED TRIPS) ---
    match /contracted_trips/{tripId} {
      // Lectura y creación de reservas desde las landings públicas permitidas
      allow read: if true;
      allow create: if true;
      // Actualización y borrado permitidos para administradores, operadores y coordinadores asignados
      allow update, delete: if isAdmin() || (isAuthenticated() && (
        resource.data.coordinator.phone == request.auth.token.phone_number ||
        request.resource.data.coordinator.phone == request.auth.token.phone_number
      ));

      // Subcolecciones de fotos en vivo, comunicados y vouchers
      match /{subcollection=**} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // --- SOLICITUDES DE PARTNERS Y CONDUCTORES (PARTNER APPLICATIONS) ---
    match /partner_applications/{appId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // --- CRM CLIENTES & EXPEDIENTES ---
    match /crm_customers/{customerId} {
      allow read: if isAuthenticated() && (request.auth.uid == customerId || isAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == customerId || isAdmin());
      allow delete: if isAdmin();
    }

    // --- AFILIADOS (AFFILIATES) ---
    match /affiliates/{affiliateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == affiliateId;
      allow update: if isAuthenticated() && (request.auth.uid == affiliateId || isAdmin());
      allow delete: if isAdmin();
    }

    // --- COORDINADORES DE EXPERIENCIAS ---
    match /coordinators/{coordId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- NOTIFICACIONES PUSH & IN-APP ---
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
  }
}
